{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Klapsentouren Live-Server starten",
      "type": "shell",
      "command": "python3 .vscode/dev_server.py",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": false
      },
      "runOptions": {
        "runOn": "default"
      }
    },
    {
      "label": "🔧 Git Index reparieren",
      "type": "shell",
      "command": "./repair-git-index.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      }
    }
  ]
}
